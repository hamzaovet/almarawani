datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/client"
}

model User {
  id           String   @id @default(cuid())
  name         String
  username     String?  @unique
  passwordHash String?
  phone        String   @unique
  pin          String   @default("123456")
  role         String   @default("cashier") // owner, manager, cashier, delivery, staff
  avatar       String?
  branch       String   @default("المعادي")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
}

model Branch {
  id             String   @id @default(cuid())
  code           String   @unique // e.g. "MAADI"
  name           String   // فرع المعادي
  address        String   // شارع النصر، دجلة، المعادي - القاهرة
  phone          String   @default("01009988771")
  isOpen         Boolean  @default(true)
  deliveryActive Boolean  @default(true)
  createdAt      DateTime @default(now())
}

model Category {
  id        String   @id @default(cuid())
  nameAr    String   @unique
  nameEn    String?
  icon      String?  // Emoji or Lucide icon name
  image     String?
  badge     String?  // "عروض حصرية", "طازج يومياً", "وفر أكثر"
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model Product {
  id              String   @id @default(cuid())
  nameAr          String
  brand           String?  // جهينة، عبور لاند، الأهرام، كريستال، فيري...
  category        String
  unit            String   @default("1 كجم") // 1 كجم، 500 جم، 1 لتر، علبة، كرتونة
  barcode         String?  // EAN-13
  costPrice       Float    @default(0) // سعر الشراء / التكلفة
  basePrice       Float    // سعر البيع الحالي
  originalPrice   Float?   // السعر الأصلي المشطوب (e.g. 50 EGP)
  discountPercent Int?     // نسبة الخصم (e.g. 20%)
  isOffer         Boolean  @default(false)
  isExpress       Boolean  @default(true) // متاح في المرواني ناو (توصيل 60 دقيقة)
  isWeighted      Boolean  @default(false) // صنف وزني بالميزان
  inStock         Boolean  @default(true)
  stockQty        Int      @default(150)
  minStockQty     Int      @default(15) // حد الطلب / النواقص
  openingStock    Int      @default(150) // رصيد أول المدة
  image           String?
  description     String?
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
}

model Order {
  id             String   @id @default(cuid())
  orderNumber    String   @unique // MRW-1001
  customerName   String
  phone          String
  address        String   // العنوان بالتفصيل
  zone           String   @default("المعادي - دجلة")
  branchName     String   @default("فرع المعادي")
  orderType      String   @default("delivery") // delivery, pickup, pos
  status         String   @default("new") // new, preparing, ready, out_for_delivery, delivered, cancelled
  items          String   // JSON: [{productId, nameAr, brand, unit, qty, unitPrice, total}]
  subtotal       Float
  deliveryFee    Float    @default(15)
  discount       Float    @default(0)
  total          Float
  paymentMethod  String   @default("cash") // cash, visa_on_delivery, instapay
  notes          String?
  captainId      String?
  captainName    String?
  captainPhone   String?
  assignedPicker String?
  timeline       String   @default("[]") // JSON: [{stage, at, by}]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Customer {
  id          String   @id @default(cuid())
  name        String
  phone       String   @unique
  address     String?
  zone        String?
  totalOrders Int      @default(0)
  totalSpend  Float    @default(0)
  notes       String?
  createdAt   DateTime @default(now())
}

model Captain {
  id        String   @id @default(cuid())
  name      String
  phone     String   @unique
  vehicle   String   @default("سكوتر المرواني السريع")
  zone      String   @default("المعادي")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model DeliveryZone {
  id          String   @id @default(cuid())
  nameAr      String   @unique
  fee         Float
  timeMinutes Int      @default(45)
  minOrder    Float    @default(100)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model Supplier {
  id             String            @id @default(cuid())
  name           String            // اسم المورد أو الشركة
  contactPerson  String?           // اسم المندوب
  phone          String            @unique
  address        String?           // العنوان
  category       String?           // التخصص (ألبان، خضار، بقالة، دواجن، منظفات...)
  openingBalance Float             @default(0) // رصيد أول المدة
  currentBalance Float             @default(0) // المستحق للمورد حالياً
  isActive       Boolean           @default(true)
  notes          String?
  createdAt      DateTime          @default(now())
  purchases      Purchase[]
  payments       SupplierPayment[]
}

model Purchase {
  id              String            @id @default(cuid())
  invoiceNumber   String            @unique // PUR-1001
  supplierId      String
  supplierName    String
  supplier        Supplier          @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  invoiceDate     String            // YYYY-MM-DD
  items           String            // JSON: [{productId, nameAr, unit, qty, costPrice, total}]
  totalAmount     Float
  paidAmount      Float             @default(0)
  remainingAmount Float             @default(0)
  paymentType     String            @default("cash") // cash, credit, partial
  notes           String?
  receivedBy      String?
  createdAt       DateTime          @default(now())
}

model SupplierPayment {
  id            String   @id @default(cuid())
  paymentNumber String   @unique // PAY-1001
  supplierId    String
  supplierName  String
  supplier      Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  amount        Float
  paymentDate   String   // YYYY-MM-DD
  paymentMethod String   @default("cash") // cash, bank_transfer, instapay, cheque
  treasury      String   @default("الخزينة الرئيسية")
  notes         String?
  recordedBy    String?
  createdAt     DateTime @default(now())
}

model StockMovement {
  id           String   @id @default(cuid())
  productId    String
  productName  String
  movementType String   // opening, purchase, sale, adjustment, return
  quantity     Int      // + or -
  balanceAfter Int
  unitCost     Float?
  reference    String?  // e.g. PUR-1001, MRW-1042, ADJ-01
  notes        String?
  performedBy  String?
  createdAt    DateTime @default(now())
}

model TreasuryTransaction {
  id           String   @id @default(cuid())
  type         String   // in, out
  category     String   // مبيعات كاشير، مبيعات دليفري، سداد مورد، مصروف تشغيلي، رصيد افتتاح
  amount       Float
  balanceAfter Float    @default(0)
  description  String
  reference    String?
  recordedBy   String?
  createdAt    DateTime @default(now())
}

model ChatMessage {
  id            String   @id @default(cuid())
  senderId      String?
  senderName    String
  senderRole    String?
  text          String
  orderNumber   String?
  customerPhone String?
  isStaff       Boolean  @default(false)
  createdAt     DateTime @default(now())
}

model SystemSettings {
  id                     String   @id @default("default")
  storeName              String   @default("سوبرماركت المرواني")
  tagline                String   @default("سلسلة سوبرماركت المرواني — أسعار الجملة وجودة الطازج")
  mainBranch             String   @default("فرع المعادي (شارع النصر / دجلة)")
  phone                  String   @default("01009988771")
  hotlines               String   @default("01009988771 | 01122334455 | 01234567890")
  whatsapp               String   @default("01009988771")
  address                String   @default("شارع النصر، دجلة، المعادي - القاهرة")
  freeDeliveryThreshold  Float    @default(400)
  expressDeliveryEnabled Boolean  @default(true)
  expressMinutes         Int      @default(60)
  isLockedDown           Boolean  @default(false)
  bannerNotice           String?  @default("⚡ التوصيل السريع بفرع المعادي شغال الآن خلال 60 دقيقة — خدمة التوصيل متوفرة يومياً من 8 صباحاً حتى 2 صباحاً")
  updatedAt              DateTime @updatedAt
}

model Expense {
  id          String   @id @default(cuid())
  description String
  amount      Float
  expenseDate String   // YYYY-MM-DD
  category    String   @default("تشغيل")
  recordedBy  String?
  createdAt   DateTime @default(now())
}
